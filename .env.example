# Copy to .env (gitignored). The start-app dev.sh script loads it on start.
# Values set here override those already exported in your shell.

# Telemetry source for discovery and live checks: mock (default) or azure.
TELEMETRY_SOURCE=azure

# Anthropic API key for the risk reasoner. Keep it commented out to use the
# key already in your shell or an `ant auth login` profile: an empty value
# here would override both.
# ANTHROPIC_API_KEY=

# Optional: override the risk reasoner model.
# RISK_REASONER_MODEL=
