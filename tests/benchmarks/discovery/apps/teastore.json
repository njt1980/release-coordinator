   "source": "examples/kubernetes/teastore-clusterip.yaml recommender env REGISTRY_HOST"
  },
  {
   "from": "persistence",
   "to": "registry",
   "proto": "http",
   "kind": "svc",
   "status": "core",
   "mechanism": "JNDI env REGISTRY_HOST from Tomcat context.xml (set by start script), not code",
   "source": "examples/kubernetes/teastore-clusterip.yaml persistence env REGISTRY_HOST"
  },
  {
   "from": "persistence",
   "to": "db",
   "proto": "db",
   "kind": "infra",
   "status": "core",
   "mechanism": "JNDI/DB_HOST via Tomcat context; persistence.xml has jdbc:mysql://localhost (overridden)",
   "source": "examples/kubernetes/teastore-clusterip.yaml persistence env DB_HOST"
  }
